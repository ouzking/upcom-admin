# =============================================================================
# UPCOM ADMIN — variables d'environnement PUBLIQUES (copier vers .env.local)
# -----------------------------------------------------------------------------
# Même projet Supabase que upcom-frontend et upcom-backend.
# ⛔ Ne JAMAIS mettre ici la service_role / clé secrète : tout ce qui commence
#    par VITE_ est embarqué dans le bundle et visible dans le navigateur.
# =============================================================================

# Local (npm run db:start dans upcom-backend) : http://127.0.0.1:54321
VITE_SUPABASE_URL=
# Clé publishable (sb_publishable_…) ou ancienne clé anon.
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL du site public (liens « Voir sur le site »). Facultatif.
VITE_PUBLIC_SITE_URL=http://localhost:5173
